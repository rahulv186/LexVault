# Database Configuration
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/lexvault

# Server Configuration
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE=104857600 # 100MB
UPLOADS_DIR=uploads

# Encryption Configuration
# Generate a 32-byte key (64 hex characters)
# Example: python3 -c "import secrets; print(secrets.token_hex(32))"
LEXVAULT_ENCRYPTION_KEY=your_64_char_hex_key_here
